{
  "name": "neuromotion-site",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test \"src/tracker/*.test.ts\" \"server/*.test.mjs\"",
    "release:check": "node scripts/release-check.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "release": "npm run release:check && npm test && npm run audit:prod && npm run build",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "node server/index.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "mail:check": "node --env-file-if-exists=.env scripts/mail-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.2",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "nodemailer": "^10.3.1",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.11.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
