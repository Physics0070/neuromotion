# Copy to .env and fill in. Never commit the real file. `npm start` reads it.
# To try real Google and email on your own machine first, use NODE_ENV=development,
# BASE_URL=http://localhost:4400 and add http://localhost:4400/api/auth/google/callback
# as an authorised redirect URI in Google Cloud. Open the site at http://localhost:4400.
NODE_ENV=production
BASE_URL=https://your-domain
SESSION_SECRET=replace-with-48-random-characters
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM="NeuroMotion <no-reply@your-domain>"
# Optional: Google sign-in (both or neither)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATABASE_PATH=/data/app.db
# Behind a reverse proxy:
# TRUST_PROXY=1
